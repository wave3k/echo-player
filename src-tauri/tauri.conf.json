{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Echo",
  "version": "1.2.0",
  "identifier": "com.echo.player",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Écho",
        "width": 1180,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost file:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Music",
    "shortDescription": "Lecteur de musique local",
    "longDescription": "Écho, lecteur de musique locale : léger, sans publicité, sans compte et sans connexion.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good"
        ],
        "recommends": [
          "gstreamer1.0-libav",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyRUIzRjM3OTlFN0YwNEMKUldSTThPZVpOei9yTXFpZkVBY2IwVEJPTkg5WXlGakJBeEM0M0VOU1NRTXFrbkhocTNyQmxpckkK",
      "endpoints": [
        "https://github.com/wave3k/echo-player/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
