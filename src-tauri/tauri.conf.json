{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MusicApp",
  "version": "0.1.0",
  "identifier": "com.musicapp.player",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MusicApp",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "AudioVideo",
    "shortDescription": "Lecteur de musique local",
    "longDescription": "Lecteur de musique et de videos locales, leger, sans pub ni compte."
  }
}
