{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Echo",
  "version": "1.0.0",
  "identifier": "com.echo.player",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Écho",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 620,
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "AudioVideo",
    "shortDescription": "Lecteur de musique local",
    "longDescription": "Écho, lecteur de musique et de vidéos locales : léger, sans publicité, sans compte et sans connexion."
  }
}
